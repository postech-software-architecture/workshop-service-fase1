POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=secret_change_me

# === SonarQube self-hosted (opcional, usado por compose.sonar.yaml) ===
SONAR_JDBC_URL=jdbc:postgresql://postgres-sonar:5432/sonarqube
SONAR_JDBC_USERNAME=sonaruser
SONAR_JDBC_PASSWORD=sonar_secret

# === SonarCloud / sonarqube.io (usado por scan local e workflow) ===
SONAR_TOKEN=seu_token_aqui
SONAR_HOST_URL=https://sonarcloud.io
SONAR_ORGANIZATION=sua_organization
SONAR_PROJECT_KEY=sua_project_key
