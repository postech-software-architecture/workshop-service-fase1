# GitHub Actions — Secrets & Variables consumidos pelo CD (.github/workflows/cd.yml).
# TEMPLATE: liste os NOMES e como obter cada valor. NAO commitar valores reais
# (Secret de Actions e write-only — nem da pra ler de volta pela UI/API).
#
# Setar via CLI:
#   Secrets:    gh secret set NOME              (le o valor do stdin — nao echoa)
#   Variables:  gh variable set NOME --body <valor-nao-sensivel>
# Ou pela UI:   Settings > Secrets and variables > Actions

# ============================================================================
# SECRETS
# ============================================================================

# --- AWS Academy (credenciais TEMPORARIAS — expiram em ~3h; renovar a cada
#     sessao do Lab e reconfigurar estes 3 secrets antes de disparar o CD) ---
AWS_ACCESS_KEY_ID=          # aws configure get aws_access_key_id     --profile academy
AWS_SECRET_ACCESS_KEY=      # aws configure get aws_secret_access_key --profile academy
AWS_SESSION_TOKEN=          # aws configure get aws_session_token     --profile academy  (obrigatorio)

# --- Banco / RDS (workshop-infra-database) ---
DB_HOST=                    # output Terraform db_host
DB_USER=                    # output Terraform db_username
DB_PASSWORD=                # mesmo valor seguro informado ao provisionar o RDS (nao e output Terraform)

# --- App (sensiveis) ---
JWT_SECRET=                 # openssl rand -hex 32
WEBHOOK_ORCAMENTO_TOKEN=    # openssl rand -hex 16
MAIL_USERNAME=              # dummy (NOTIFICACAO_CANAL=log — mail nao e usado)
MAIL_PASSWORD=              # dummy

# ============================================================================
# VARIABLES (nao-sensivel)
# ============================================================================
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=workshop-eks
DB_NAME=workshop             # output Terraform db_name (nao sensivel)
