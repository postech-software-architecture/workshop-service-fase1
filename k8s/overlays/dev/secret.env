# Segredos do ambiente DEV — valores DUMMY, so para rodar local (kind). NUNCA use em nuvem.
# O Postgres in-cluster (postgres.yaml) e criado com estes DB_USER/DB_PASSWORD, entao app e
# banco ficam consistentes por construcao.
DB_USER=myuser
DB_PASSWORD=secret
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_ORCAMENTO_TOKEN=local-token
MAIL_USERNAME=dummy
MAIL_PASSWORD=dummy
