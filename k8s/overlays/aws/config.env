# Config nao-sensivel do ambiente AWS (EKS + RDS).
# DB_HOST e injetado no deploy a partir do output do Terraform (endpoint do RDS) — o valor
# abaixo e um placeholder porque o endpoint so existe apos `terraform apply` (ver README.md).
SPRING_PROFILES_ACTIVE=docker
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=workshop
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@workshop.local
NOTIFICACAO_CANAL=log
# NRDOT Service (created by the W5 EKS observability deployment). The Java agent
# exports traces through gRPC; Micrometer exports business metrics through OTLP/HTTP.
OTEL_EXPORTER_OTLP_ENDPOINT=http://nr-k8s-otel-collector.newrelic.svc.cluster.local:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://nr-k8s-otel-collector.newrelic.svc.cluster.local:4318/v1/metrics
DEPLOYMENT_ENVIRONMENT=prod
OTEL_RESOURCE_ATTRIBUTES=service.name=workshop-service,deployment.environment=prod,service.version=unknown
