# Config nao-sensivel do ambiente AWS (EKS + RDS).
# DB_HOST e injetado no deploy a partir do output do Terraform (endpoint do RDS) — o valor
# abaixo e um placeholder porque o endpoint so existe apos `terraform apply` (ver README.md).
SPRING_PROFILES_ACTIVE=docker
DB_HOST=REPLACE_WITH_RDS_ENDPOINT
DB_PORT=5432
DB_NAME=mydatabase
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM=no-reply@workshop.local
NOTIFICACAO_CANAL=log
